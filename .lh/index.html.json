            "date": 1728961209735,
            "name": "Commit-0",
            "content": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>SnapStory</title>\r\n    <link rel=\"stylesheet\" href=\"./style.css\">\r\n    <link rel=\"shortcut icon\" href=\"./assets/snapstoryicon.png\" type=\"image/x-icon\">\r\n    <script src=\"https://kit.fontawesome.com/0fcc8b9f34.js\" crossorigin=\"anonymous\"></script>\r\n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@glidejs/glide@latest/dist/css/glide.core.min.css\">\r\n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@glidejs/glide@latest/dist/css/glide.theme.min.css\">\r\n    <style>\r\n        .body {\r\n            transition: background-image 0.5s ease-in-out;\r\n        }\r\n        #exploreButton {\r\n            transition: background-color 0.5s ease-in-out;\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n    <div class=\"body\">\r\n        <header class=\"navbar\">\r\n            <div class=\"nav-image\">\r\n                <img src=\"./assets/snapstoryicon.png\" alt=\"Logo\">\r\n                <h5>SnapStory</h5>\r\n            </div>\r\n            <div class=\"nav-list\" id=\"navList\">\r\n                <button id=\"closeMenu\"><i class=\"fa-solid fa-xmark\"></i>X</button>\r\n                <li><a href=\"#\">Discover</a></li>\r\n                <li><a href=\"#\">Stories</a></li>\r\n                <li><a href=\"#\">Contests</a></li>\r\n                <li><a href=\"#\">Login</a></li>\r\n            </div>\r\n            <div class=\"hamburger\" id=\"hamburgerToggle\">\r\n                <i class=\"fa-solid fa-bars\"></i>\r\n            </div>\r\n        </header>\r\n        <div class=\"main-container\">\r\n            <div class=\"left\">\r\n                <h1 id=\"headerText\">LandScapes</h1>\r\n                <p id=\"descriptionText\">Landscaping is the process of changing the visual features of land. It is a great way to improve the appearance of a property. It can also be used to increase its value. A landscaper can use different techniques to create beautiful, functional landscapes. It is important to understand the basics of landscaping to create a successful design.</p>\r\n                <button id=\"exploreButton\">Explore now</button>\r\n            </div>\r\n            <div class=\"right\">\r\n                <div class=\"glide\">\r\n                    <div class=\"glide__track\" data-glide-el=\"track\">\r\n                      <ul class=\"glide__slides\">\r\n                        <li class=\"glide__slide\" data-bg=\"url('./assets/portraiton.jpeg')\" data-button-color=\"#385F55\" data-header=\"Portraits\" \r\n                        data-description=\"A portrait is a painting, photograph, sculpture, or other artistic representation of a person, in which the face is always predominant. In arts, a portrait can be represented as half body and even full body. If the subject in full body better represents personality and mood - this type of presentation can be chosen.\">\r\n                        <div style=\"background-image: url('./assets/portraiton.jpeg');\"></div></li>\r\n                       \r\n                        <li class=\"glide__slide\" data-bg=\"url('./assets/Carsback.png')\" data-button-color=\"#5F1B1C\" data-header=\"Cars\" \r\n                        data-description=\"Cars are fascinating, aren’t they? Whether you’re interested in the latest models, \r\n                        looking to buy a new or used car, or just curious about different types of vehicles, there’s a lot to explore.\r\n                        Are you looking for something specific, like a particular model or type of car? \">\r\n                        <div  style=\"background-image: url('./assets/Carsback.png')\"></div></li>\r\n                       \r\n                        <li class=\"glide__slide\" data-bg=\"url('./assets/Sports.png')\" data-button-color=\"#0382E8\" data-header=\"Sports\"\r\n                        data-description=\"Sport is a form of physical activity or game. Often competitive and organized, sports use, maintain, or improve physical ability and skills. They also provide enjoyment to participants and, in some cases, entertainment to spectators.[2] Many sports exist, with different participant numbers, some are done by a single person with others being done by hundreds.\">\r\n                        <div  style=\"background-image: url('./assets/Sports.png');\"></div></li>\r\n                       \r\n                        <li class=\"glide__slide\" data-bg=\"url('./assets/taneli-lahtinen-bJiisZmEB2M-unsplash.jpg')\" data-button-color=\"#50B61B\" data-header=\"LandScapes\" \r\n                        data-description=\"Landscaping is the process of changing the visual features of land. It is a great way to improve the appearance of a property. It can also be used to increase its value. A landscaper can use different techniques to create beautiful, functional landscapes. It is important to understand the basics of landscaping to create a successful design.\">\r\n                        <div  style=\"background-image: url('./assets/taneli-lahtinen-bJiisZmEB2M-unsplash.jpg');\"></div></li>\r\n                      </ul>\r\n                    </div>\r\n                  </div>\r\n            </div>\r\n        </div>\r\n        <footer>\r\n            <p>UIBYDAMI</p>\r\n        </footer>\r\n    </div>\r\n<script src=\"https://cdn.jsdelivr.net/npm/@glidejs/glide@latest/dist/glide.min.js\"></script>\r\n<script src=\"./super.js\"></script>\r\n\r\n</body>\r\n</html>\r\n"
        }
